# Server
PORT=3000
# IMPORTANT: change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development
APP_URL=http://localhost:5173

# Password-reset email. When RESEND_API_KEY is absent during development,
# Route-Flow logs the reset link and returns a development token to the UI.
RESEND_API_KEY=
RESET_FROM_EMAIL=Route-Flow <no-reply@your-domain.ng>

# External free services (no API key required)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
