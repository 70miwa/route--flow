# Server
PORT=3000
# IMPORTANT: change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development
# Public URL used in password-reset links after deployment
APP_URL=https://your-route-flow-domain.example

# Password-reset email. When RESEND_API_KEY is absent during development,
# Route-Flow logs the reset link and returns a development token to the UI.
RESEND_API_KEY=
RESET_FROM_EMAIL=Route-Flow <no-reply@your-domain.ng>

# Optional seed-account passwords. If omitted, npm run seed generates random
# passwords and prints them once when it creates new seed users.
SEED_DEMO_PASSWORD=
SEED_ADA_PASSWORD=

# External free services (no API key required)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
